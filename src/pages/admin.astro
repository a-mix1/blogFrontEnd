<div class="login-box">
  <input
    type="password"
    id="adminPassword"
    placeholder="Enter password"
  />

  <button id="loginBtn">
    Enter
  </button>

  <p id="errorMsg"></p>
</div>


<div class="container" id="container">
  <h1>Create Blog</h1>

  <form id="blogForm">

    <label>Title</label>
    <input type="text" name="title" required />

    <label>Cover Image</label>
    <input type="file" name="coverImage" accept="image/*" />

    <label>Doc File</label>
    <input type="file" name="blogFile" accept=".docx" required />

    <label>Status</label>
    <select name="status">
      <option value="Published">Published</option>
      <option value="draft">Draft</option>
    </select>

    <button type="submit">Publish Post</button>

  </form>
</div>

<script>



const PASSWORD = import.meta.env.PUBLIC_ADMIN_PASSWORD;

  const btn = document.getElementById("loginBtn");

  btn.addEventListener("click", () => {
    const input = document.getElementById("adminPassword").value;
    const container = document.getElementById("container");
    const errorMsg = document.getElementById("errorMsg");

    if (input === PASSWORD) {
      container.style.display = "block";
      errorMsg.textContent = "";
    } else {
      errorMsg.textContent = "Wrong password";
    }
  });

  const form = document.getElementById('blogForm');
  const button =form.querySelector('button');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    
    button.disabled = true;
    button.textContent = 'Uploading...';
    try{
    const formData = new FormData(form);


    const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/blogs/admin`, {
      method: 'POST',
      body: formData
    });

    const data = await res.json();
    console.log(data);
  
    
    if (!res.ok) {
    alert(data.message || data.error || 'Upload failed');
    return;
     
        
  }
  else
  {
      alert('Blog uploaded 🚀');
      window.location.href = '/'; 
      return
  }
}
catch(err)
{
   button.disabled = false;
    button.textContent = 'Publish';
    console.log(err);
}
 
    
  });
</script>


